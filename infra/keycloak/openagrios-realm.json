{
  "id": "openagrios",
  "realm": "openagrios",
  "displayName": "OpenAgriOS DX-OS Open-Core SSO",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "FARMER",
        "description": "Nông hộ khai báo vùng canh tác, đặt lịch và xác nhận nghiệm thu"
      },
      {
        "name": "COORDINATOR",
        "description": "Điều phối viên HTX lập kế hoạch, ghép cặp máy-người và phê duyệt BPMN"
      },
      {
        "name": "MACHINE_OWNER",
        "description": "Chủ máy quản lý đội máy và xác nhận điều động thiết bị"
      },
      {
        "name": "OPERATOR",
        "description": "Người vận hành máy cập nhật tiến độ hiện trường và báo sự cố"
      },
      {
        "name": "REPAIR_TEAM",
        "description": "Đội sửa chữa tiếp nhận phiếu sửa và cập nhật kết quả bảo trì"
      },
      {
        "name": "PLATFORM_ADMIN",
        "description": "Quản trị kỹ thuật nền tảng DX-OS Core"
      }
    ]
  },
  "clients": [
    {
      "clientId": "agriops-web",
      "name": "AgriOps Multi-Role RTS Workspace",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8000/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "organization_id_mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "organization_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "organization_id",
            "jsonType.label": "String"
          }
        }
      ],
      "secret": "agriops-client-secret-2026",
      "clientAuthenticatorType": "client-secret"
    },
    {
      "clientId": "agriops-gateway",
      "name": "Apache APISIX Zero-Trust Gateway Confidential Client",
      "enabled": true,
      "publicClient": false,
      "secret": "agriops-gateway-secret-2026",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
