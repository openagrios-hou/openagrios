    {
      "name": "03. Kiểm tra Phân quyền RBAC (403) & Cách ly Đa tổ chức RLS",
      "item": [
        {
          "name": "3.1. GET /api/v1/state (Role FARMER) — Quyền hiển thị vùng ruộng theo chủ sở hữu",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{farmer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/state",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "state"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const fullFields = json.fields.filter(f => f.visibility === 'FULL').map(f => f.field_id);",
                  "pm.test('RLS Visibility: Farmer Ba has FULL access to F01, F03, F07', () => {",
                  "    pm.expect(fullFields).to.deep.equal(['F01', 'F03', 'F07']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2. GET /api/v1/state (Tenant HTX_SOCTRANG_02) — Cách ly dữ liệu giữa các HTX",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{st_coord_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/state",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "state"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Multi-tenancy RLS: Sóc Trăng only sees F_ST01', () => {",
                  "    pm.expect(json.fields.length).to.eql(1);",
                  "    pm.expect(json.fields[0].field_id).to.eql('F_ST01');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3. POST /api/v1/assignments (Role FARMER) — Chặn vượt quyền điều phối (403 Forbidden)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{farmer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_id\": \"REQ-04\",\n  \"machine_id\": \"M02\",\n  \"operator_id\": \"OP-02\",\n  \"start_time\": \"2026-11-20T13:00:00Z\",\n  \"end_time\": \"2026-11-20T17:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/assignments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "assignments"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Farmer is blocked with 403 Forbidden when trying to dispatch machine', () => {",
                  "    pm.response.to.have.status(403);",
                  "    pm.expect(pm.response.json().error).to.eql('RBAC_FORBIDDEN');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04. Đặt lịch & Kiểm tra Xung đột Khung giờ (409 Conflict)",
      "item": [
        {
          "name": "4.1. POST /api/v1/requests — Nông hộ Bác Ba tạo yêu cầu thu hoạch vùng F07",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{farmer_token}}"
              },
              {
                "key": "Content-Type",
