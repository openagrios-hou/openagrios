    {
      "name": "02. Keycloak OIDC SSO Login",
      "item": [
        {
          "name": "2.1. GET /api/v1/auth/pkce/authorize-url — Khởi tạo phiên PKCE & State (RFC 7636)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('pkce_code', json.code);",
                  "pm.collectionVariables.set('pkce_code_verifier', json.code_verifier);",
                  "pm.collectionVariables.set('pkce_state', json.state);",
                  "pm.test('Khởi tạo phiên PKCE thành công', () => {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    pm.expect(json.code_challenge).to.be.a('string');",
                  "    pm.expect(json.code_verifier).to.be.a('string');",
                  "    pm.expect(json.code).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/pkce/authorize-url?state=csrf-pm-state-999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "pkce",
                "authorize-url"
              ],
              "query": [
                {
                  "key": "state",
                  "value": "csrf-pm-state-999"
                }
              ]
            },
            "description": "Tạo phiên OAuth 2.0 PKCE và mã anti-CSRF state token."
          }
        },
        {
          "name": "2.2. POST /api/v1/auth/pkce/token — Đổi Authorization Code lấy Live JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('coord_token', json.access_token);",
                  "pm.test('Đổi mã PKCE lấy Live JWT Token thành công', () => {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    pm.expect(json.access_token).to.be.a('string');",
                  "    pm.expect(json.pkce_verified).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"code\": \"{{pkce_code}}\",\n    \"code_verifier\": \"{{pkce_code_verifier}}\",\n    \"state\": \"{{pkce_state}}\",\n    \"username\": \"coord_htx01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/pkce/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "pkce",
                "token"
              ]
            },
            "description": "Trao đổi Authorization Code và code_verifier đã được mã hoá S256 để nhận Live Keycloak Bearer Token."
          }
        },
