              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Core is HEALTHY & BPMN XML loaded', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('HEALTHY');",
                  "    pm.expect(json.bpmn_definitions).to.have.property('service_request');",
                  "    pm.expect(json.bpmn_definitions).to.have.property('incident_replan');",
                  "});"
                ]
              }
            }
          ]
