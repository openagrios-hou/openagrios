  "item": [
    {
      "name": "01. Headless Core Discovery & Health",
      "item": [
        {
          "name": "1.1. GET / — Headless PaaS Discovery Manifest",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON Headless Manifest', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.service).to.include('Headless Core PaaS');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2. GET /api/v1/health — Kiểm tra các dịch vụ Core & BPMN 2.0 XML",
          "request": {
            "method": "GET",
            "header": [],
