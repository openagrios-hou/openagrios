          }
        },
        {
          "name": "4.2. POST /api/v1/assignments — Xếp trùng lịch máy M01 (409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coord_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_id\": \"REQ-04\",\n  \"machine_id\": \"M01\",\n  \"operator_id\": \"OP-01\",\n  \"start_time\": \"2026-11-20T08:00:00Z\",\n  \"end_time\": \"2026-11-20T11:30:00Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/assignments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "assignments"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Overlapping shift on M01 is rejected with 409 Conflict', () => {",
                  "    pm.response.to.have.status(409);",
                  "    pm.expect(pm.response.json().error).to.eql('MACHINE_TIME_OVERLAP');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05. Báo cáo Sự cố, Lưu trữ S3 & Điều phối Thay thế BPMN 2.0",
      "item": [
        {
          "name": "5.1. POST /api/v1/incidents — Lái máy op_minh báo hỏng M01 + Lưu S3 + Đề xuất máy thay thế",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{op_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"machine_id\": \"M01\",\n  \"severity\": \"CRITICAL\",\n  \"incident_type\": \"Đứt dây curoa buồng đập & Kẹt trục cuốn\",\n  \"description\": \"Máy M01 hỏng tại F01, cần dừng 24h để thay dây curoa.\",\n  \"estimated_downtime_hours\": 24,\n  \"evidence_filename\": \"minh_chung_dut_curoa_M01.jpg\",\n  \"force_no_option\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/incidents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "incidents"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('M01 breakdown impacts ASG-102 & ASG-103 and recommends M02 replacement', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(json.impacted_assignment_ids).to.include('ASG-102');",
                  "    pm.expect(json.candidate_options[0].machine_id).to.eql('M02');",
                  "    pm.collectionVariables.set('top_option_id', json.candidate_options[0].option_id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5.2. POST /api/v1/incidents/INC-2026-001/approve-replan — Điều phối viên duyệt BPMN điều M02 thay thế",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coord_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
