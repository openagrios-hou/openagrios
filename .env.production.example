# ============================================================================
# OPENAGRIOS — PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.production.example .env
# 2. Generate cryptographically strong random secrets:
#    openssl rand -hex 32
# 3. Fill in all mandatory production secrets below.
# 4. Never commit the populated .env file to version control.
# ============================================================================

# --- Core Platform Runtime ---
PORT=8000
OPENAGRIOS_AUTH_MODE=KEYCLOAK_PRODUCTION
OPENAGRIOS_STORAGE_MODE=POSTGRESQL_PRODUCTION

# --- PostgreSQL 16 (Relational DB & RLS Engine) ---
POSTGRES_USER=openagrios
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32_superuser_password
POSTGRES_DB=openagrios_db
POSTGRES_APP_USER=openagrios_app
POSTGRES_APP_PASSWORD=replace_with_openssl_rand_hex_32_app_password

# --- Keycloak 24 (OIDC 1.0 & Zero-Trust SSO) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_openssl_rand_hex_32_keycloak_admin
KEYCLOAK_ISSUER=http://keycloak:8080/realms/openagrios
KEYCLOAK_INTROSPECTION_CLIENT_ID=agriops-gateway
KEYCLOAK_INTROSPECTION_CLIENT_SECRET=replace_with_openssl_rand_hex_32_gateway_secret

# --- SeaweedFS S3 (Unstructured Object Storage) ---
S3_ENDPOINT=http://object-storage:9000
S3_ACCESS_KEY=replace_with_s3_access_key
S3_SECRET_KEY=replace_with_s3_secret_key

# --- Flowable BPMN 2.0 (Workflow Execution Engine) ---
FLOWABLE_REST_URL=http://flowable:8081/flowable-rest
FLOWABLE_ENDPOINT=http://flowable:8081/flowable-rest

# --- Apache APISIX (Zero-Trust API Gateway) ---
GATEWAY_HTTP_PORT=9080
GATEWAY_HTTPS_PORT=9443
APISIX_ADMIN_KEY=replace_with_openssl_rand_hex_32_apisix_key
