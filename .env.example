# ============================================================================
# OPENAGRIOS ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Sao chép tệp này thành .env trước khi chạy: cp .env.example .env
# Lưu ý: Tuyệt đối không commit mật khẩu thật lên kho mã nguồn!
# ============================================================================

# 1. Identity & Auth Mode
# Giá trị: KEYCLOAK_PRODUCTION (yêu cầu Keycloak live) hoặc DEV_MOCK_STANDALONE (demo/CI)
OPENAGRIOS_AUTH_MODE=KEYCLOAK_PRODUCTION
KEYCLOAK_ISSUER=http://keycloak:8080/realms/openagrios
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
KEYCLOAK_REALM=openagrios

# 2. Structured Data (PostgreSQL 16)
POSTGRES_USER=openagrios
POSTGRES_PASSWORD=openagrios_dev_only
POSTGRES_DB=openagrios_db
DATABASE_URL=jdbc:postgresql://postgres:5432/openagrios_db

# 3. Object Storage (SeaweedFS S3 - Apache-2.0)
S3_ENDPOINT=http://object-storage:9000
S3_BUCKET=openagrios-evidence

# 4. Workflow Engine (Flowable BPMN 2.0 REST - Apache-2.0)
FLOWABLE_REST_URL=http://flowable:8081/flowable-rest
FLOWABLE_ENDPOINT=http://flowable:8081/flowable-rest

# 5. Core Ports
CORE_API_PORT=8000
APISIX_GATEWAY_PORT=9080
